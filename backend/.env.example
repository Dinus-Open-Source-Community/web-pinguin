API_ADDR=127.0.0.1:8080
LISTING_DIR=/absolute/path/to/mirror/root
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local Laragon PostgreSQL. Keep credentials outside source control.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pinguin_dinus
DB_USER=pinguin_app
DB_PASSWORD=replace-with-local-password
DB_SSLMODE=disable
DB_TIMEOUT_SECONDS=5

# HS256 admin JWT signing key (generate with: go run ./cmd/admin-jwt -generate-secret).
# Set JWT_SCREET temporarily only for compatibility with the existing local .env typo.
JWT_SECRET=
JWT_SECRET_PREVIOUS=
JWT_ISSUER=web-pinguin
JWT_AUDIENCE=web-pinguin-admin

# Optional local MaxMind GeoLite2 City database for Nginx IP geolocation.
GEOIP_DB_PATH=

WORKER_INTERVAL_SECONDS=60
WORKER_BATCH_SIZE=5000
