# Server & Runtime Configuration
API_ADDR=127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Direktori lokal mirror yang disinkronkan dari Nevacloud, bukan URL HTTPS.
# Contoh Windows: E:/Mahasiswa/SEM 3/doscom_project/web-pinguin/mirror-sample
# Contoh Linux: /var/www/mirror
LISTING_DIR=C:/mirrors/ubuntu

# Database Connection (Go Backend)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pinguin_dinus
DB_USER=pinguin_app
DB_PASSWORD=change-me-locally
DB_SSLMODE=disable
DB_TIMEOUT_SECONDS=5

# Docker Compose PostgreSQL environment variables
POSTGRES_DB=pinguin_dinus
POSTGRES_USER=pinguin_app
POSTGRES_PASSWORD=change-me-locally

# HS256 admin JWT signing key (generate with: go run ./cmd/admin-jwt -generate-secret, min 32 chars)
JWT_SECRET=change-with-min-32-chars-secret-key-locally
JWT_SECRET_PREVIOUS=
JWT_ISSUER=web-pinguin
JWT_AUDIENCE=web-pinguin-admin

# Optional local MaxMind GeoLite2 City database for Nginx IP geolocation
GEOIP_DB_PATH=

# Background analytics worker
WORKER_INTERVAL_SECONDS=60
WORKER_BATCH_SIZE=5000
