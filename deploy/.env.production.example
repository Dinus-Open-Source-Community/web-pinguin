PUBLIC_DOMAIN=portal.example.org
IMAGE_PREFIX=registry.example.org/pinguin/backend
APP_VERSION=replace-with-reviewed-release-tag
MIRROR_DIR=/srv/mirrors/portal
POSTGRES_DB=pinguin_dinus
POSTGRES_USER=pinguin_app
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DB_NAME=pinguin_dinus
DB_USER=pinguin_app
DB_PASSWORD=replace-with-the-same-long-random-secret
DB_PORT=5432
DB_SSLMODE=disable
# Generate with: go run ./cmd/admin-jwt -generate-secret
JWT_SECRET=replace-with-a-random-256-bit-secret
# Set the old signing key temporarily during rotation, then remove after token expiry.
JWT_SECRET_PREVIOUS=
JWT_ISSUER=web-pinguin
JWT_AUDIENCE=web-pinguin-admin
CORS_ALLOWED_ORIGINS=https://portal.example.org
WORKER_INTERVAL_SECONDS=60
WORKER_BATCH_SIZE=5000
RETENTION_INTERVAL_SECONDS=86400
RETENTION_BATCH_SIZE=1000
RETENTION_RAW_EVENTS_DAYS=90
RETENTION_SURVEY_ANSWERS_DAYS=365
RETENTION_SURVEY_CONTACTS_DAYS=90
RETENTION_AUDIT_LOGS_DAYS=365
# Required only for: docker compose --profile import run --rm nginx-import
NGINX_ACCESS_LOG_FILE=/srv/mirror-ops/access.log
GEOIP_DB_FILE=/srv/geoip/GeoLite2-City.mmdb
CATALOG_MANIFEST=/srv/catalog/catalog.json
